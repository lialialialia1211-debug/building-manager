{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals", "vite/client", "node"]
  },
  "include": [
    "src/main.tsx",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/AgeGate.tsx",
    "src/components/AssetImage.tsx",
    "src/components/CardTray.tsx",
    "src/components/ComicBuilderScreen.tsx",
    "src/components/ComicPanelSlot.tsx",
    "src/components/DialogueOverlay.tsx",
    "src/components/EndingReader.tsx",
    "src/components/RevealSequence.tsx",
    "src/domain/builder-state.ts",
    "src/domain/dialogue.ts",
    "src/domain/episode-schema.ts",
    "src/domain/load-episode.ts",
    "src/domain/persistence.ts",
    "src/domain/route-resolver.ts",
    "src/test/setup.ts",
    "tests/*.test.ts",
    "tests/*.test.tsx",
    "scripts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
